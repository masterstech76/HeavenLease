# ============================================================================
# HeavenLease production environment template (backend/.env.aws.example)
# ============================================================================
# Copy this file to backend/.env.aws on your server and fill in real values.
# NEVER commit the real .env.aws file — it is git-ignored (see .gitignore).
# Generate fresh secrets with:
#   openssl rand -base64 48   -> JWT_SECRET
#   openssl rand -base64 32   -> APP_ENCRYPTION_KEY
# ============================================================================

# ---- PostgreSQL (AWS RDS) ----
SPRING_PROFILES_ACTIVE=prod
DB_HOST=your-db.cluster-xxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=heavenlease
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# true only if RDS IAM database authentication is enabled (otherwise false + DB_PASSWORD above)
RDS_USE_IAM=false

# ---- Security secrets (generate fresh - never use these) ----
JWT_SECRET=CHANGE_ME_base64_48_random
APP_ENCRYPTION_KEY=CHANGE_ME_base64_32_random

# ---- Admin bootstrap account (created on first boot only if no admin exists) ----
ADMIN_EMAIL=admin@heavenlease.in
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD_8PLUS

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://heavenlease.in,https://www.heavenlease.in

# ---- AWS (region + credentials used for SES/SNS/DynamoDB/RDS-IAM) ----
AWS_REGION=ap-south-1
RDS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=no-reply@heavenlease.in
AWS_SNS_ACCESS_KEY=
AWS_SNS_SECRET_KEY=
AWS_SNS_REGION=ap-south-1
AWS_SNS_SENDER_ID=HEAVENLEASE
DYNAMODB_TABLE=HeavenLease_Counters

# ---- Integrations (can also be set in Admin -> Integration Settings) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERSION=v3
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- OTP ----
OTP_FROM_EMAIL=no-reply@heavenlease.in
# Keep OFF in production: only set true for a controlled/dev demo where the
# 6-digit code may be shown on-screen when no SMS gateway is available.
OTP_SELF_HOSTED_PREVIEW=false

# ---- Runtime ----
UPLOAD_DIR=/app/uploads
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=20
# ================= HEAVENLEASE NATIVE 2FA =================
# Email OTP is generated by the HeavenLease Java backend and delivered via
# your own mailbox/SMTP server. This does NOT use AWS SES/SNS for 2FA.
SMTP_HOST=smtp.your-mail-server.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@heavenlease.in
SMTP_PASSWORD=YOUR_MAILBOX_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
OTP_FROM_EMAIL=no-reply@heavenlease.in
TWO_FACTOR_EMAIL_ENABLED=true
TWO_FACTOR_EMAIL_OTP_EXPIRY_SECONDS=300
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_SECONDS=30
TWO_FACTOR_ISSUER=HeavenLease
TWO_FACTOR_TOTP_DIGITS=6
TWO_FACTOR_TOTP_PERIOD=30
