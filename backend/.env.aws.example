# ============================================================
# HeavenLease — AWS PRODUCTION .env TEMPLATE (SAFE TO COMMIT)
#
# HOW TO USE:
#   1. Copy this file to backend/.env.aws ON THE EC2 SERVER:
#        cp backend/.env.aws.example backend/.env.aws
#   2. Fill in every value below (or run scp from your PC to
#      upload the real .env.aws directly — recommended).
#   3. NEVER commit the real backend/.env.aws — this repo is
#      PUBLIC, so committing secrets instantly leaks them.
#
# Generate secrets with:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -base64 32   (APP_ENCRYPTION_KEY)
# ============================================================

# ---------- RDS PostgreSQL (NO local database) ----------
DB_HOST=your-rds-endpoint.<region>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=heavenlease
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
RDS_USE_IAM=false

# ---------- JWT & Encryption ----------
JWT_SECRET=CHANGE_ME
APP_ENCRYPTION_KEY=CHANGE_ME

# ---------- Admin bootstrap ----------
ADMIN_EMAIL=admin@heavenlease.in
ADMIN_PASSWORD=CHANGE_ME

# ---------- CORS / Domains ----------
CORS_ALLOWED_ORIGINS=https://heavenlease.in,https://www.heavenlease.in

# ---------- AWS (region + credentials) ----------
AWS_REGION=ap-south-1
RDS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
DYNAMODB_TABLE=HeavenLease_Counters

# ---------- AWS SES — Email OTP ----------
AWS_SES_ACCESS_KEY=CHANGE_ME
AWS_SES_SECRET_KEY=CHANGE_ME
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=no-reply@heavenlease.in

# ---------- AWS SNS — SMS OTP (empty = phone OTP uses self-hosted preview) ----------
AWS_SNS_ACCESS_KEY=
AWS_SNS_SECRET_KEY=
AWS_SNS_REGION=ap-south-1
AWS_SNS_SENDER_ID=HEAVEN

# ---------- Integrations (Google, reCAPTCHA) ----------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
RECAPTCHA_SITE_KEY=CHANGE_ME
RECAPTCHA_SECRET_KEY=CHANGE_ME
RECAPTCHA_VERSION=v3

# ---------- Razorpay (empty = payments stay disabled in-app until keys added) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Uploads / counts / rate limit ----------
UPLOAD_DIR=/app/uploads
SEED_DEMO=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=20
OTP_FROM_EMAIL=no-reply@heavenlease.in