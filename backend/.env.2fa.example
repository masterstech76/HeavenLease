# HeavenLease-owned 2FA email delivery. These values are for YOUR SMTP/mailbox,
# not AWS SES/SNS and not an OTP provider.
SMTP_HOST=smtp.your-mail-server.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@heavenlease.in
SMTP_PASSWORD=YOUR_MAILBOX_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
OTP_FROM_EMAIL=no-reply@heavenlease.in

# 2FA policy
TWO_FACTOR_EMAIL_ENABLED=true
TWO_FACTOR_EMAIL_OTP_EXPIRY_SECONDS=300
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_SECONDS=30
TWO_FACTOR_ISSUER=HeavenLease
TWO_FACTOR_TOTP_DIGITS=6
TWO_FACTOR_TOTP_PERIOD=30
